generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth.js / NextAuth models (required by @auth/prisma-adapter)
// ============================================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String? // null for Google-only accounts

  summaryLength      SummaryLength @default(STANDARD)
  emailNotifications Boolean       @default(true)
  notionApiKey       String?
  notionDatabaseId   String?

  onboardingCompleted Boolean @default(false)
  tourCompleted       Boolean @default(false)
  role                String?
  teamSize            String?
  primaryUseCase      String?

  // Billing (plan, stripeCustomerId, stripeSubscriptionId, subscriptionStatus,
  // currentPeriodEnd) lives on Workspace, not here -- a subscription pays for
  // a team.

  accounts        Account[]
  sessions        Session[]
  integrations    Integration[]
  notifications   Notification[]
  workspaceMember WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Workspaces / team collaboration
// ============================================================

model Workspace {
  id      String @id @default(cuid())
  name    String
  ownerId String

  // Billing lives here, not on User: a subscription pays for a team, not
  // for one isolated person.
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // "active" | "trialing" | "past_due" | "canceled" | null
  currentPeriodEnd     DateTime?

  meetings Meeting[]
  team     WorkspaceMember[]
  invites  WorkspaceInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
}

enum SummaryLength {
  CONCISE
  STANDARD
  DETAILED
}

enum Plan {
  FREE
  PRO
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  provider     String // "google-calendar" | "zoom"
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  meetingId String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum NotificationType {
  SUCCESS
  WARNING
  INFO
  NEUTRAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Domain models
// ============================================================

enum MeetingStatus {
  PROCESSING
  DONE
  FAILED
}

enum MeetingMood {
  POSITIVE
  NEUTRAL
  TENSE
}

enum DecisionStatus {
  CONFIRMED
  PENDING
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  TODO
  DONE
}

enum ExportPlatform {
  NOTION
  SLACK
  EMAIL
}

enum ExportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisagreementSeverity {
  LOW
  MEDIUM
  HIGH
}

model Meeting {
  id    String @id @default(cuid())
  title String
  // userId = who uploaded it (attribution). workspaceId = the real access
  // scope; every query filters on that, so a meeting is visible to the whole
  // team, not just its uploader.
  userId      String
  workspaceId String
  audioUrl    String?
  duration    Int? // seconds
  status      MeetingStatus @default(PROCESSING)
  summary     String?       @db.Text
  mood        MeetingMood?

  isPublic   Boolean @default(false)
  shareToken String? @unique

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  participants  Participant[]
  transcripts   Transcript[]
  decisions     Decision[]
  actionItems   ActionItem[]
  exports       Export[]
  disagreements Disagreement[]
  embeddings    MeetingEmbedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Participant {
  id        String  @id @default(cuid())
  meetingId String
  name      String
  email     String?
  avatarUrl String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Transcript {
  id        String   @id @default(cuid())
  meetingId String
  speaker   String
  timestamp String
  content   String   @db.Text

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Decision {
  id        String         @id @default(cuid())
  meetingId String
  statement String         @db.Text
  status    DecisionStatus @default(CONFIRMED)
  timestamp String?
  proposer  String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model ActionItem {
  id        String         @id @default(cuid())
  meetingId String
  task      String
  owner     String?
  deadline  DateTime?
  priority  ActionPriority @default(MEDIUM)
  status    ActionStatus   @default(TODO)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Export {
  id        String         @id @default(cuid())
  meetingId String
  platform  ExportPlatform
  target    String
  status    ExportStatus   @default(PENDING)
  createdAt DateTime       @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model MeetingEmbedding {
  id        String   @id @default(cuid())
  meetingId String
  chunkText String   @db.Text
  embedding Json // array of floats -- cosine similarity computed in application code, no pgvector needed
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Disagreement {
  id           String               @id @default(cuid())
  meetingId    String
  topic        String
  quote        String               @db.Text
  severity     DisagreementSeverity @default(MEDIUM)
  participants String[]             @default([])

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
