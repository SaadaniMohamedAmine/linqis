DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:port/database?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:port/database?sslmode=require

# Frontend -> backend API base URL. Next.js and Express deploy separately
# (Vercel + Railway), so the browser needs an absolute URL to reach the API.
# In prod, set this to your Railway backend URL (e.g. https://linqis-api.up.railway.app).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Express: which origin is allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000
# Public URL of the Next.js app itself -- used for metadata/OG/sitemap/robots.
# In prod, set this to your Vercel domain (e.g. https://linqis.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth
AUTH_SECRET=your_auth_secret
AUTH_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers
HUGGINGFACE_API_KEY=your_huggingface_api_key
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Notion
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# Email (SMTP) -- used by the Express server (server/src/services/export/email.ts)
# for meeting exports.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Linqis <your_email@gmail.com>"
# Recipient for the public /contact form submissions (server/src/routes/contact.ts).
# Falls back to SMTP_USER if unset.
SALES_EMAIL=sales@linqis.app

# Next.js email (password reset) -- separate from server/.env's SMTP config
# above. src/lib/email.ts has its own nodemailer transporter (it can't import
# server/src/services/export/email.ts -- different deployable, wouldn't
# resolve at runtime) and reads the exact same var names: SMTP_HOST,
# SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM. Next.js (Vercel)
# and the Express server (Railway) are separate deployments with separate env
# var stores in production, so each is configured independently there even
# though the names match. Locally both processes load this same repo-root
# .env, so the SMTP_* values declared above are picked up by both -- no
# additional local vars needed. The reset-password link is built from
# NEXT_PUBLIC_SITE_URL (already declared near the top of this file).

# Zoom API
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Google Calendar (dedicated OAuth callback -- NOT the NextAuth login callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Shared secret used to sign short-lived tokens the frontend attaches to
# every Express API call, since Express (Railway) can't read NextAuth's
# session cookies (Vercel) directly. Same value must be visible to both
# the Next.js process and the Express process. Generate with:
# openssl rand -base64 32
BACKEND_JWT_SECRET=your_backend_jwt_secret

# Stripe (TEST MODE KEYS ONLY -- sk_test_/pk_test_/whsec_..., never live keys
# on this project). STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally
# or the webhook endpoint's signing secret in the Stripe dashboard.
# STRIPE_PRO_PRICE_ID is the price id of the "Linqis Pro" recurring price
# created in the Stripe test dashboard.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
