DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:port/database?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:port/database?sslmode=require

# Frontend -> backend API base URL. Next.js and Express deploy separately
# (Vercel + Railway), so the browser needs an absolute URL to reach the API.
# In prod, set this to your Railway backend URL (e.g. https://linqis-api.up.railway.app).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Express: which origin is allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth
AUTH_SECRET=your_auth_secret
AUTH_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers
HUGGINGFACE_API_KEY=your_huggingface_api_key
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Notion
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Linqis <your_email@gmail.com>"

# Zoom API
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Google Calendar
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
